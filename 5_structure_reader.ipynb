   "source": [
    "## Step 4 — Data Model\n",
    "The `StructureModel` is the unified format that holds all extracted structural data,\n",
    "regardless of whether it came from DXF, image, or text."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4e35f83e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Data model defined\n"
     ]
    }
   ],
   "source": [
    "@dataclass\n",
    "class Member:\n",
    "    \"\"\"A structural/architectural member with dimensions.\"\"\"\n",
    "    name:        str\n",
    "    count:       int   = 1\n",
    "    length_m:    float = 0.0\n",
    "    width_m:     float = 0.0\n",
    "    depth_m:     float = 0.0\n",
    "    area_sqm:    float = 0.0\n",
    "    volume_cum:  float = 0.0\n",
    "    unit:        str   = \"\"\n",
    "    notes:       str   = \"\"\n",
    "\n",
    "    def compute_volume(self):\n",
    "        if self.length_m and self.width_m and self.depth_m:\n",
    "            self.volume_cum = round(self.length_m * self.width_m * self.depth_m * self.count, 3)\n",
    "        elif self.area_sqm and self.depth_m:\n",
    "            self.volume_cum = round(self.area_sqm * self.depth_m * self.count, 3)\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class StructureModel:\n",
    "    \"\"\"Complete structure data extracted from any input format.\"\"\"\n",
    "    source:           str   = \"\"\n",
    "    source_file:      str   = \"\"\n",
    "    building_type:    str   = \"\"\n",
    "    floors:           int   = 1\n",
    "    plinth_area_sqm:  float = 0.0\n",
    "    total_height_m:   float = 0.0\n",
    "\n",
    "    # Substructure\n",
    "    earthwork:        list = field(default_factory=list)\n",
    "    footings:         list = field(default_factory=list)\n",
    "    foundation_walls: list = field(default_factory=list)\n",
    "    pcc:              list = field(default_factory=list)\n",
    "\n",
    "    # Superstructure\n",
    "    columns:          list = field(default_factory=list)\n",
    "    beams:            list = field(default_factory=list)\n",
    "    slabs:            list = field(default_factory=list)\n",
    "    walls:            list = field(default_factory=list)\n",
    "    staircases:       list = field(default_factory=list)\n",
    "\n",
    "    # Finishes\n",
    "    plastering:       list = field(default_factory=list)\n",
    "    flooring:         list = field(default_factory=list)\n",
    "\n",
    "    # Openings\n",
    "    doors:            list = field(default_factory=list)\n",
    "    windows:          list = field(default_factory=list)\n",
    "\n",
    "    raw_notes:        str  = \"\"\n",
    "\n",
    "    def summary(self):\n",
    "        lines = [\n",
    "            f\"Building Type  : {self.building_type}\",\n",
    "            f\"Source         : {self.source}  ({self.source_file})\",\n",
    "            f\"Floors         : {self.floors}\",\n",
    "            f\"Plinth Area    : {self.plinth_area_sqm} sqm\",\n",
    "            f\"Total Height   : {self.total_height_m} m\",\n",
    "            \"\",\n",
    "            \"── MEMBERS ──────────────────────────────────────\",\n",
    "        ]\n",
    "        categories = [\n",
    "            (\"Earthwork\",         self.earthwork),\n",
    "            (\"Footings\",          self.footings),\n",
    "            (\"PCC\",               self.pcc),\n",
    "            (\"Columns\",           self.columns),\n",
    "            (\"Beams\",             self.beams),\n",
    "            (\"Slabs\",             self.slabs),\n",
    "            (\"Walls\",             self.walls),\n",
    "            (\"Plastering\",        self.plastering),\n",
    "            (\"Flooring\",          self.flooring),\n",
    "            (\"Doors\",             self.doors),\n",
    "            (\"Windows\",           self.windows),\n",
    "            (\"Staircases\",        self.staircases),\n",
    "        ]\n",
    "        for cat_name, members in categories:\n",
    "            if members:\n",
    "                lines.append(f\"\\n  {cat_name}:\")\n",
    "                for m in members:\n",
    "                    lines.append(\n",
    "                        f\"    • {m.name} | count={m.count} | \"\n",
    "                        f\"{m.length_m}×{m.width_m}×{m.depth_m} m | \"\n",
    "                        f\"vol={m.volume_cum} cum | area={m.area_sqm} sqm\"\n",
    "                    )\n",
    "        return \"\\n\".join(lines)\n",
    "\n",
    "    def to_json(self):\n",
    "        return json.dumps(asdict(self), indent=2)\n",
    "\n",
    "\n",
    "print(\"Data model defined\")"
   ]
  },
