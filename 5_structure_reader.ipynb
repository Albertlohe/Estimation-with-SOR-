   "metadata": {},
   "source": [
    "## Step 5A — DXF Reader\n",
    "Reads AutoCAD DXF files. Extracts columns, beams, walls, slabs etc. by layer name.\n",
    "\n",
    "> ⚠️ **DWG files:** Convert to DXF first in AutoCAD → Save As → DXF  \n",
    "> Or free online: https://cloudconvert.com/dwg-to-dxf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "4acf373e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ DXF Reader defined\n"
     ]
    }
   ],
   "source": [
    "class DXFReader:\n",
    "    \"\"\"\n",
    "    Reads AutoCAD DXF and extracts structural geometry by layer name.\n",
    "    Recognises standard PWD layer naming: COLUMN, BEAM, SLAB, WALL, FOOTING, DOOR, WINDOW etc.\n",
    "    \"\"\"\n",
    "\n",
    "    LAYER_MAP = {\n",
    "        \"column\":     [\"COLUMN\", \"COL\", \"COLUMNS\", \"RCC-COL\"],\n",
    "        \"beam\":       [\"BEAM\", \"BM\", \"BEAMS\", \"RCC-BEAM\"],\n",
    "        \"slab\":       [\"SLAB\", \"SLABS\", \"RCC-SLAB\", \"ROOF\"],\n",
    "        \"wall\":       [\"WALL\", \"WALLS\", \"BRICKWORK\", \"BRICK\", \"PARTITION\"],\n",
    "        \"footing\":    [\"FOOTING\", \"FTG\", \"FOOTINGS\", \"FOUND-FTG\"],\n",
    "        \"door\":       [\"DOOR\", \"DR\", \"DOORS\"],\n",
    "        \"window\":     [\"WINDOW\", \"WIN\", \"WDW\", \"WINDOWS\"],\n",
    "        \"stair\":      [\"STAIR\", \"STAIRCASE\", \"STAIRS\"],\n",
    "        \"foundation\": [\"FOUNDATION\", \"FOUND\", \"PLINTH\"],\n",
    "        \"pcc\":        [\"PCC\", \"LEAN\", \"BLINDING\"],\n",
    "        \"earthwork\":  [\"EARTHWORK\", \"EXCAVATION\", \"EXCAV\"],\n",
    "    }\n",
    "\n",
    "    def __init__(self, filepath):\n",
    "        self.filepath = filepath\n",
    "\n",
    "    def _load(self):\n",
    "        ext = Path(self.filepath).suffix.lower()\n",
    "        if ext == \".dwg\":\n",
    "            raise ValueError(\n",
    "                \"DWG is proprietary. Convert to DXF first:\\n\"\n",
    "                \"  AutoCAD → Save As → DXF\\n\"\n",
    "                \"  OR free online: https://cloudconvert.com/dwg-to-dxf\"\n",
    "            )\n",
    "        self.doc = ezdxf.readfile(self.filepath)\n",
    "        self.msp = self.doc.modelspace()\n",
    "        print(f\"  ✅ DXF loaded : {self.filepath}\")\n",
    "        print(f\"     Version    : {self.doc.dxfversion}\")\n",
    "        print(f\"     Units      : {self.doc.units}\")\n",
    "        print(f\"     Layers     : {len(list(self.doc.layers))}\")\n",
    "\n",
    "    def _get_unit_scale(self):\n",
    "        \"\"\"Convert drawing units → metres.\"\"\"\n",
    "        scales = {0: 0.001, 1: 0.0000254, 2: 0.0003048,\n",
    "                  4: 0.001, 5: 0.01, 6: 1.0, 7: 1000.0}\n",
    "        return scales.get(self.doc.units, 0.001)\n",
    "\n",
    "    def _layer_category(self, layer_name):\n",
    "        upper = layer_name.upper().strip()\n",
    "        for category, keywords in self.LAYER_MAP.items():\n",
    "            for kw in keywords:\n",
    "                if kw in upper:\n",
    "                    return category\n",
    "        return None\n",
    "\n",
    "    def _entity_length(self, entity, scale):\n",
    "        t = entity.dxftype()\n",
    "        try:\n",
    "            if t == \"LINE\":\n",
    "                p1, p2 = entity.dxf.start, entity.dxf.end\n",
    "                return math.dist((p1.x, p1.y), (p2.x, p2.y)) * scale\n",
    "            elif t in (\"LWPOLYLINE\", \"POLYLINE\"):\n",
    "                pts = list(entity.get_points()) if t == \"LWPOLYLINE\" else [v.dxf.location for v in entity.vertices]\n",
    "                coords = [(p[0], p[1]) for p in pts]\n",
    "                total = sum(math.dist(coords[i], coords[i+1]) for i in range(len(coords)-1))\n",
    "                return total * scale\n",
    "            elif t == \"CIRCLE\":\n",
    "                return 2 * math.pi * entity.dxf.radius * scale\n",
    "            elif t == \"ARC\":\n",
    "                angle = abs(entity.dxf.end_angle - entity.dxf.start_angle)\n",
    "                return (angle / 360) * 2 * math.pi * entity.dxf.radius * scale\n",
    "        except Exception:\n",
    "            pass\n",
    "        return 0.0\n",
    "\n",
    "    def read(self):\n",
    "        self._load()\n",
    "        scale = self._get_unit_scale()\n",
    "        model = StructureModel(source=\"dxf\", source_file=self.filepath)\n",
    "\n",
    "        category_lines  = {}\n",
    "        category_areas  = {}\n",
    "        category_counts = {}\n",
    "        layer_names     = set()\n",
    "\n",
    "        for entity in self.msp:\n",
    "            layer = entity.dxf.layer\n",
    "            layer_names.add(layer)\n",
    "            cat = self._layer_category(layer)\n",
    "            if not cat:\n",
    "                continue\n",
    "            t = entity.dxftype()\n",
    "            if t in (\"LINE\", \"LWPOLYLINE\", \"POLYLINE\", \"ARC\"):\n",
    "                length = self._entity_length(entity, scale)\n",
    "                category_lines[cat] = category_lines.get(cat, 0) + length\n",
    "            elif t == \"INSERT\":\n",
    "                category_counts[cat] = category_counts.get(cat, 0) + 1\n",
    "\n",
    "        print(\"\\n  Layers detected:\")\n",
    "        for ln in sorted(layer_names):\n",
    "            cat = self._layer_category(ln)\n",
    "            print(f\"    [{cat or '—':12s}] {ln}\")\n",
    "\n",
    "        print(\"\\n  Extracted geometry:\")\n",
    "        for cat, length in category_lines.items():\n",
    "            print(f\"    {cat:15s} total length : {length:.2f} m\")\n",
    "        for cat, cnt in category_counts.items():\n",
    "            print(f\"    {cat:15s} count        : {cnt}\")\n",
    "\n",
    "        # Build model\n",
    "        col_count = category_counts.get(\"column\", 0) or max(1, int(category_lines.get(\"column\", 0) / 1.2))\n",
    "        if col_count:\n",
    "            model.columns.append(Member(name=\"RCC Columns\", count=col_count, notes=\"From DXF column layer\"))\n",
    "\n",
    "        beam_len = category_lines.get(\"beam\", 0)\n",
    "        if beam_len:\n",
    "            model.beams.append(Member(name=\"RCC Beams\", count=1, length_m=round(beam_len, 2)))\n",
    "\n",
    "        wall_len = category_lines.get(\"wall\", 0)\n",
    "        if wall_len:\n",
    "            m = Member(name=\"Brick Masonry Walls\", count=1, length_m=round(wall_len, 2), width_m=0.23, depth_m=3.0)\n",
    "            m.compute_volume()\n",
    "            model.walls.append(m)\n",
    "\n",
    "        ftg_count = category_counts.get(\"footing\", 0) or col_count\n",
    "        if ftg_count:\n",
    "            model.footings.append(Member(name=\"RCC Footings\", count=ftg_count))\n",
    "\n",
    "        door_count = category_counts.get(\"door\", 0)\n",
    "        if door_count:\n",
    "            model.doors.append(Member(name=\"Doors\", count=door_count))\n",
    "\n",
    "        win_count = category_counts.get(\"window\", 0)\n",
    "        if win_count:\n",
    "            model.windows.append(Member(name=\"Windows\", count=win_count))\n",
    "\n",
    "        if model.plinth_area_sqm:\n",
    "            m = Member(name=\"Earthwork Excavation\", count=1, area_sqm=model.plinth_area_sqm, depth_m=1.5)\n",
    "            m.compute_volume()\n",
    "            model.earthwork.append(m)\n",
    "\n",
    "        return model\n",
    "\n",
    "\n",
    "print(\"✅ DXF Reader defined\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9dfa008f",
   "metadata": {},
   "source": [
    "## Step 5B — Image / PDF Drawing Reader\n",
    "Sends your drawing image or PDF to Claude Vision API.  \n",
    "The AI reads dimension lines, annotations, title blocks — everything a human engineer reads."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "fb38d713",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Image/PDF Reader defined\n"
     ]
    }
   ],
   "source": [
    "class ImageReader:\n",
    "    \"\"\"\n",
    "    Reads structural drawing from image (JPG/PNG) or PDF.\n",
    "    Uses Claude Vision to extract dimensions and member details.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, api_key):\n",
    "        self.client = Anthropic(api_key=api_key)\n",
    "\n",
    "    def _load_image_bytes(self, filepath):\n",
    "        ext = Path(filepath).suffix.lower()\n",
    "        if ext == \".pdf\":\n",
    "            try:\n",
    "                from pdf2image import convert_from_path\n",
    "                pages = convert_from_path(filepath, dpi=200, first_page=1, last_page=1)\n",
    "                img = pages[0]\n",
    "            except Exception:\n",
    "                with pdfplumber.open(filepath) as pdf:\n",
    "                    img = pdf.pages[0].to_image(resolution=200).original\n",
    "            with tempfile.NamedTemporaryFile(suffix=\".jpg\", delete=False) as f:\n",
    "                img.save(f.name, \"JPEG\", quality=90)\n",
    "                img_bytes = open(f.name, \"rb\").read()\n",
    "            return img_bytes, \"image/jpeg\"\n",
    "        else:\n",
    "            img_bytes = open(filepath, \"rb\").read()\n",
    "            media_type = {\".jpg\": \"image/jpeg\", \".jpeg\": \"image/jpeg\",\n",
    "                          \".png\": \"image/png\", \".webp\": \"image/webp\"}.get(ext, \"image/jpeg\")\n",
    "            return img_bytes, media_type\n",
    "\n",
    "    def read(self, filepath):\n",
    "        print(f\"  Reading drawing: {filepath}\")\n",
    "        img_bytes, media_type = self._load_image_bytes(filepath)\n",
    "        img_b64 = base64.standard_b64encode(img_bytes).decode(\"utf-8\")\n",
    "        print(\"  Sending to Claude Vision API...\")\n",
    "\n",
    "        prompt = \"\"\"You are an expert civil engineer analysing a structural/architectural drawing.\n",
    "Read ALL annotations, dimensions, title blocks, section marks carefully.\n",
    "\n",
    "Return ONLY a JSON object:\n",
    "{\n",
    "  \"building_type\": \"Residential/Commercial/Office/Bridge/Other\",\n",
    "  \"floors\": 1, \"plinth_area_sqm\": 0, \"total_height_m\": 0,\n",
    "  \"drawing_scale\": \"1:100\", \"drawing_type\": \"Plan/Section/Elevation\",\n",
    "  \"columns\":   [{\"name\":\"\",\"count\":0,\"width_m\":0,\"depth_m\":0,\"height_m\":0,\"notes\":\"\"}],\n",
    "  \"beams\":     [{\"name\":\"\",\"count\":0,\"length_m\":0,\"width_m\":0,\"depth_m\":0,\"notes\":\"\"}],\n",
    "  \"slabs\":     [{\"name\":\"\",\"count\":1,\"area_sqm\":0,\"thickness_m\":0,\"notes\":\"\"}],\n",
    "  \"walls\":     [{\"name\":\"\",\"count\":0,\"length_m\":0,\"height_m\":0,\"thickness_m\":0,\"notes\":\"\"}],\n",
    "  \"footings\":  [{\"name\":\"\",\"count\":0,\"length_m\":0,\"width_m\":0,\"depth_m\":0,\"notes\":\"\"}],\n",
    "  \"doors\":     [{\"count\":0,\"width_m\":0.9,\"height_m\":2.1}],\n",
    "  \"windows\":   [{\"count\":0,\"width_m\":1.2,\"height_m\":1.2}],\n",
    "  \"staircases\":[{\"count\":0,\"notes\":\"\"}],\n",
    "  \"additional_notes\": \"\"\n",
    "}\n",
    "Convert all dimensions to metres. Return ONLY the JSON.\"\"\"\n",
    "\n",
    "        response = self.client.messages.create(\n",
    "            model=\"claude-opus-4-5\",\n",
    "            max_tokens=2000,\n",
    "            messages=[{\"role\": \"user\", \"content\": [\n",
    "                {\"type\": \"image\", \"source\": {\"type\": \"base64\", \"media_type\": media_type, \"data\": img_b64}},\n",
    "                {\"type\": \"text\",  \"text\": prompt}\n",
    "            ]}]\n",
    "        )\n",
    "        raw = response.content[0].text.strip()\n",
    "        print(\"  ✅ Vision response received\")\n",
    "\n",
    "        try:\n",
    "            data = json.loads(re.sub(r\"```json|```\", \"\", raw).strip())\n",
    "        except json.JSONDecodeError:\n",
    "            print(\"  ⚠️  JSON parse issue — storing raw response\")\n",
    "            data = {}\n",
    "\n",
    "        return self._build_model(data, filepath, raw)\n",
    "\n",
    "    def _build_model(self, data, filepath, raw):\n",
    "        model = StructureModel(source=\"image\", source_file=filepath)\n",
    "        model.building_type   = data.get(\"building_type\", \"\")\n",
    "        model.floors          = int(data.get(\"floors\", 1))\n",
    "        model.plinth_area_sqm = float(data.get(\"plinth_area_sqm\", 0))\n",
    "        model.total_height_m  = float(data.get(\"total_height_m\", 0))\n",
    "        model.raw_notes       = data.get(\"additional_notes\", \"\")\n",
    "\n",
    "        def _m(item, default_name):\n",
    "            m = Member(\n",
    "                name     = item.get(\"name\", default_name),\n",
    "                count    = int(item.get(\"count\", 1)),\n",
    "                length_m = float(item.get(\"length_m\", 0)),\n",
    "                width_m  = float(item.get(\"width_m\", item.get(\"thickness_m\", 0))),\n",
    "                depth_m  = float(item.get(\"depth_m\", item.get(\"height_m\", 0))),\n",
    "                area_sqm = float(item.get(\"area_sqm\", 0)),\n",
    "                notes    = item.get(\"notes\", \"\")\n",
    "            )\n",
    "            m.compute_volume()\n",
    "            return m\n",
    "\n",
    "        for i in data.get(\"columns\",    []): model.columns.append(_m(i, \"Column\"))\n",
