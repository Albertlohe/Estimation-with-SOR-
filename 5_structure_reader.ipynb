     ]
    }
   ],
   "source": [
    "class StructureReader:\n",
    "    \"\"\"\n",
    "    Auto-detects input type and calls the right reader.\n",
    "\n",
    "    Usage:\n",
    "        reader = StructureReader(api_key=ANTHROPIC_API_KEY)\n",
    "        model  = reader.read(\"building.dxf\")      # AutoCAD\n",
    "        model  = reader.read(\"drawing.jpg\")        # Image\n",
    "        model  = reader.read(\"drawing.pdf\")        # PDF\n",
    "        model  = reader.read(\"G+2 building...\")    # Text\n",
    "    \"\"\"\n",
    "\n",
    "    IMAGE_EXTS = {\".jpg\", \".jpeg\", \".png\", \".gif\", \".webp\", \".bmp\"}\n",
    "    CAD_EXTS   = {\".dxf\", \".dwg\"}\n",
    "    PDF_EXTS   = {\".pdf\"}\n",
    "\n",
    "    def __init__(self, api_key):\n",
    "        self.api_key = api_key\n",
    "\n",
    "    def read(self, input_data):\n",
    "        print(\"\\n\" + \"═\"*50)\n",
    "        print(\"  STRUCTURE READER\")\n",
    "        print(\"═\"*50)\n",
    "\n",
    "        if os.path.exists(input_data):\n",
    "            ext = Path(input_data).suffix.lower()\n",
    "            if ext in self.CAD_EXTS:\n",
    "                print(\"  Input type : AutoCAD DXF/DWG\")\n",
    "                return DXFReader(input_data).read()\n",
    "            elif ext in self.IMAGE_EXTS:\n",
    "                print(\"  Input type : Drawing Image\")\n",
    "            \n",
    "                return ImageReader(self.api_key).read(input_data)\n",
    "            elif ext in self.PDF_EXTS:\n",
    "                print(\"  Input type : PDF Drawing\")\n",
    "                return ImageReader(self.api_key).read(input_data)\n",
    "            else:\n",
    "                raise ValueError(f\"Unsupported file type: {ext}\")\n",
    "        else:\n",
    "            print(\"  Input type : Text Description\")\n",
    "            return TextReader(self.api_key).read(input_data)\n",
    "\n",
    "\n",
    "print(\"✅ Master StructureReader defined\")\n",
    "print()\n",
    "print(\"All readers ready! Proceed to Step 7 to run.\")"
   ]
