      "✅ Text Reader defined\n"
     ]
    }
   ],
   "source": [
    "class TextReader:\n",
    "    \"\"\"\n",
    "    Parses a typed description of a structure using Claude LLM.\n",
    "    Applies standard PWD India norms for missing values.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, api_key):\n",
    "        self.client = Anthropic(api_key=api_key)\n",
    "\n",
    "    def read(self, description):\n",
    "        print(\"  Parsing text description with AI...\")\n",
    "\n",
    "        prompt = f\"\"\"You are an expert civil engineer interpreting a structure description for cost estimation.\n",
    "\n",
    "STRUCTURE DESCRIPTION:\n",
    "\\\"\\\"\\\"{description}\\\"\\\"\\\"\n",
    "\n",
    "Extract ALL structural details. Apply standard PWD India norms for missing values.\n",
    "Return ONLY a JSON object:\n",
    "{{\n",
    "  \"building_type\": \"Residential/Commercial/Office/Other\",\n",
    "  \"floors\": 1, \"plinth_area_sqm\": 0, \"total_height_m\": 0,\n",
    "  \"frame_type\": \"RCC/Loadbearing\",\n",
    "  \"columns\":   [{{\"name\":\"Main columns\",\"count\":0,\"width_m\":0,\"depth_m\":0,\"height_m\":0,\"grade\":\"M20\",\"notes\":\"\"}}],\n",
    "  \"beams\":     [{{\"name\":\"Main beams\",\"count\":0,\"length_m\":0,\"width_m\":0,\"depth_m\":0,\"grade\":\"M20\",\"notes\":\"\"}}],\n",
    "  \"slabs\":     [{{\"name\":\"Floor slab\",\"count\":0,\"area_sqm\":0,\"thickness_m\":0.125,\"grade\":\"M20\",\"notes\":\"\"}}],\n",
    "  \"walls\":     [{{\"name\":\"External walls\",\"count\":0,\"length_m\":0,\"height_m\":0,\"thickness_m\":0.23,\"mortar\":\"1:6\",\"notes\":\"\"}}],\n",
    "  \"footings\":  [{{\"name\":\"Isolated footings\",\"count\":0,\"length_m\":0,\"width_m\":0,\"depth_m\":0,\"grade\":\"M20\"}}],\n",
    "  \"pcc\":       [{{\"name\":\"PCC 1:4:8\",\"area_sqm\":0,\"thickness_m\":0.1}}],\n",
    "  \"earthwork\": [{{\"name\":\"Earthwork excavation\",\"area_sqm\":0,\"depth_m\":0}}],\n",
    "  \"plastering\":[{{\"name\":\"Internal plaster 12mm 1:4\",\"area_sqm\":0}},{{\"name\":\"External plaster 15mm 1:5\",\"area_sqm\":0}}],\n",
    "  \"flooring\":  [{{\"name\":\"Floor finish\",\"area_sqm\":0,\"notes\":\"\"}}],\n",
    "  \"doors\":     [{{\"count\":0,\"width_m\":0.9,\"height_m\":2.1}}],\n",
    "  \"windows\":   [{{\"count\":0,\"width_m\":1.2,\"height_m\":1.2}}],\n",
    "  \"staircases\":[{{\"count\":0,\"floors_served\":0,\"notes\":\"\"}}],\n",
    "  \"assumptions_made\": []\n",
    "}}\n",
    "Return ONLY the JSON, no other text.\"\"\"\n",
    "\n",
    "        response = self.client.messages.create(\n",
    "            model=\"claude-opus-4-5\",\n",
    "            max_tokens=3000,\n",
    "            messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "        )\n",
    "        raw = response.content[0].text.strip()\n",
    "        print(\"  ✅ Text parsing complete\")\n",
    "\n",
    "        try:\n",
    "            data = json.loads(re.sub(r\"```json|```\", \"\", raw).strip())\n",
    "        except json.JSONDecodeError:\n",
    "            print(\"  ⚠️  JSON parse issue\")\n",
    "            data = {}\n",
    "\n",
    "        return self._build_model(data, description)\n",
    "\n",
    "    def _build_model(self, data, description):\n",
    "        model = StructureModel(source=\"text\", source_file=\"<typed description>\")\n",
    "        model.building_type   = data.get(\"building_type\", \"\")\n",
    "        model.floors          = int(data.get(\"floors\", 1))\n",
    "        model.plinth_area_sqm = float(data.get(\"plinth_area_sqm\", 0))\n",
    "        model.total_height_m  = float(data.get(\"total_height_m\", 0))\n",
    "        model.raw_notes       = str(data.get(\"assumptions_made\", \"\"))\n",
    "\n",
    "        def _m(item, default_name):\n",
    "            m = Member(\n",
    "                name     = item.get(\"name\", default_name),\n",
    "                count    = int(item.get(\"count\", 1)),\n",
    "                length_m = float(item.get(\"length_m\", 0)),\n",
    "                width_m  = float(item.get(\"width_m\", item.get(\"thickness_m\", 0))),\n",
    "                depth_m  = float(item.get(\"depth_m\", item.get(\"height_m\", 0))),\n",
    "                area_sqm = float(item.get(\"area_sqm\", 0)),\n",
    "                notes    = item.get(\"notes\", item.get(\"grade\", \"\"))\n",
    "            )\n",
    "            m.compute_volume()\n",
    "            return m\n",
    "\n",
    "        for i in data.get(\"columns\",    []): model.columns.append(_m(i, \"Column\"))\n",
    "        for i in data.get(\"beams\",      []): model.beams.append(_m(i, \"Beam\"))\n",
    "        for i in data.get(\"slabs\",      []): model.slabs.append(_m(i, \"Slab\"))\n",
    "        for i in data.get(\"walls\",      []): model.walls.append(_m(i, \"Wall\"))\n",
    "        for i in data.get(\"footings\",   []): model.footings.append(_m(i, \"Footing\"))\n",
    "        for i in data.get(\"pcc\",        []): model.pcc.append(_m(i, \"PCC\"))\n",
    "        for i in data.get(\"earthwork\",  []): model.earthwork.append(_m(i, \"Earthwork\"))\n",
    "        for i in data.get(\"plastering\", []): model.plastering.append(_m(i, \"Plaster\"))\n",
    "        for i in data.get(\"flooring\",   []): model.flooring.append(_m(i, \"Flooring\"))\n",
    "        for i in data.get(\"doors\",      []): model.doors.append(_m(i, \"Door\"))\n",
    "        for i in data.get(\"windows\",    []): model.windows.append(_m(i, \"Window\"))\n",
    "        for i in data.get(\"staircases\", []): model.staircases.append(_m(i, \"Staircase\"))\n",
    "        return model\n",
    "\n",
    "\n",
    "print(\"✅ Text Reader defined\")"
   ]
