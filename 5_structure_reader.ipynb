    "### Option C — Drawing Image or PDF\n",
    "Put your drawing file in the same folder and update the filename below."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e10d9556",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Set your drawing file here ──────────────────────────────\n",
    "DRAWING_FILE = \"floor_plan.jpg\"    # ← change this (.jpg/.png/.pdf)\n",
    "# ────────────────────────────────────────────────────────────\n",
    "\n",
    "reader = StructureReader(api_key=ANTHROPIC_API_KEY)\n",
    "model  = reader.read(DRAWING_FILE)\n",
    "\n",
    "print(\"\\n\" + \"═\"*50)\n",
    "print(\"  EXTRACTED STRUCTURE MODEL\")\n",
    "print(\"═\"*50)\n",
    "print(model.summary())"
   ]
